# 环境变量样例 —— 复制为 .env 后按需填写（.env 已被 .gitignore 忽略，绝不入库）
#
# 三个子服务共享本文件时，所有变量统一注入各容器
# （compose 已将无关变量隔离：每个服务只读取自己认识的那部分）

# ═══ blood_pressure_agent（ReAct 客服 Agent）═══
# LLM 密钥：必须从环境变量注入，代码零硬编码（缺失时启动降级、调用时报错）
BP_LLM_API_KEY=your-api-key-here
BP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_MODEL=qwen-max

# Embedding 供应商（local=本地 bge-small-zh-v1.5；dashscope=云端 text-embedding-v3）
BP_EMBED_PROVIDER=local
DASHSCOPE_API_KEY=

# ═══ 三服务通用 ═══
# 限流阈值：每分钟每 IP 允许的请求数（0=关闭限流）
RATE_LIMIT_RPM=60
# 日志格式：json=结构化（生产/采集器）；text=人读（本地调试）
BP_LOG_FORMAT=json

# ═══ P4 平台安全（三服务通用）═══
# API Key 双级鉴权：逗号分隔，可配多个；两者都留空=本地开发模式（不鉴权）
# 普通 Key：业务查询端点；管理 Key：管理端点（重置/灰度发布/审批等）+ 隐含普通权限
BP_API_KEYS=
BP_ADMIN_KEYS=
# 审计日志路径（管理操作 JSONL 留痕；各子服务默认写自己容器内 logs/audit.jsonl）
# BP_AUDIT_PATH=/data/logs/audit.jsonl

# ═══ bp_monitor_service_agent：Skill 变更审批 gate ═══
# auto=评估通过后自动应用（默认，向后兼容）；manual=转入待审批队列，
# 经 GET /approvals 查看单据、POST /approvals/{id}/approve|reject 人工处置
BP_APPROVAL_MODE=auto

# ═══ blood_pressure_agent：LLM 网关备链路（三项全配才启用主备切换）═══
BP_LLM_FALLBACK_BASE_URL=
BP_LLM_FALLBACK_API_KEY=
BP_LLM_FALLBACK_MODEL=

# ═══ blood_pressure_agent：会话状态外置（解锁多副本水平扩展）═══
# 留空=进程内存（默认）；启用 redis profile 后填 redis://redis:6379/0
# BP_REDIS_URL=redis://redis:6379/0
